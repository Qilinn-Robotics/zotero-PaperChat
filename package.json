{
  "name": "zotero-paperchat",
  "type": "module",
  "version": "0.1.0",
  "author": "qilinli",
  "description": "PaperChat: a clean AI sidebar for Zotero.",
  "homepage": "https://github.com/qilinli/zotero-PaperChat",
  "config": {
    "addonName": "PaperChat",
    "addonID": "paperchat@qilinli.local",
    "addonRef": "paperchat",
    "addonInstance": "PaperChat",
    "prefsPrefix": "extensions.zotero.paperchat"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qilinli/zotero-PaperChat.git"
  },
  "bugs": {
    "url": "https://github.com/qilinli/zotero-PaperChat/issues"
  },
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release"
  },
  "dependencies": {
    "katex": "^0.16.28",
    "markdown-it": "^14.1.1",
    "zotero-plugin-toolkit": "^5.0.0-0"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.14.0",
    "eslint": "^9.24.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.29.1",
    "zotero-plugin-scaffold": "^0.4.2",
    "zotero-types": "^4.0.0-beta.3"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
